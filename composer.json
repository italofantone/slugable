{
    "name": "italofantone/sluggable",
    "description": "Is a PHP library designed to simplify and automate the creation of URL-friendly slugs based on Laravel.",
    "keywords": ["slug", "slugable", "sluggable", "eloquent", "laravel"],
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3|^12.0",
        "orchestra/testbench": "^9.2|^10.0|^11.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Italofantone\\Sluggable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Italofantone\\Sluggable\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Italo Morales Fantone",
            "email": "i@rimorsoft.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Italofantone\\Sluggable\\SluggableServiceProvider"
            ]
        }
    }
}
